{
  "manifest_version": 3,
  "name": "쿠팡 골드박스 후보 수집기",
  "version": "0.1.4",
  "description": "로그인 정보나 쿠키를 읽지 않고 현재 쿠팡 파트너스 골드박스 화면의 공개 상품 후보만 JSON으로 저장합니다.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["https://partners.coupang.com/*", "https://www.coupang.com/*", "https://*.coupangcdn.com/*", "https://blogauto.hongzi.us/*"],
  "background": {
    "service_worker": "batch-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://blogauto.hongzi.us/*"],
      "js": ["bridge-blogauto.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "쿠팡 골드박스 후보 수집기",
    "default_popup": "popup.html"
  }
}
