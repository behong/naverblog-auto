{
  "manifest_version": 3,
  "name": "네이버 초안 입력 도우미",
  "version": "0.5.41",
  "description": "blogauto.hongzi.us에서 승인된 초안을 검증 후 네이버에 전체공개 발행하고 공개 URL을 기록합니다.",
  "permissions": ["storage", "tabs", "debugger", "alarms", "offscreen", "clipboardWrite"],
  "host_permissions": [
    "https://blogauto.hongzi.us/*",
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "네이버 초안 입력 도우미"
  },
  "content_scripts": [
    {
      "matches": ["https://blogauto.hongzi.us/*"],
      "js": ["bridge-blogauto.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://blog.naver.com/*", "https://m.blog.naver.com/*"],
      "js": ["naver-editor.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
